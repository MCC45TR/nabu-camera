From f4b70c49325b6bc5d4b3a7ab69da9e26a8edb2c4 Mon Sep 17 00:00:00 2001
From: mcc45tr <mcc45tr@gmail.com>
Date: Sun, 6 Sep 2026 02:31:48 +0300
Subject: [PATCH 5/5] pipeline: simple: expose and safely reset camera flash

---
 src/libcamera/camera_flash.cpp           |  2 +-
 src/libcamera/control_ids_core.yaml      |  6 ++++--
 src/libcamera/pipeline/simple/simple.cpp | 14 ++++++++++++++
 3 files changed, 19 insertions(+), 3 deletions(-)

diff --git a/src/libcamera/camera_flash.cpp b/src/libcamera/camera_flash.cpp
index d3b9fbf7..ad440ea9 100644
--- a/src/libcamera/camera_flash.cpp
+++ b/src/libcamera/camera_flash.cpp
@@ -195,7 +195,7 @@ std::optional<int32_t> CameraFlash::getSubdevControl(uint32_t id) const
 {
 	ControlList controlList = subdev_->getControls(std::array{ id });
 
-	if (controlList.contains(id))
+	if (!controlList.contains(id))
 		return std::nullopt;
 
 	return controlList.get(id).get<int32_t>();
diff --git a/src/libcamera/control_ids_core.yaml b/src/libcamera/control_ids_core.yaml
index 6995f28f..6f3a45c8 100644
--- a/src/libcamera/control_ids_core.yaml
+++ b/src/libcamera/control_ids_core.yaml
@@ -1401,7 +1401,8 @@ controls:
       type: int32_t
       direction: inout
       description: |
-        Flash intensity in mA. Used when the flash is operated in flash mode.
+        Flash intensity in microamperes. Used when the flash is operated in
+        flash mode.
 
   - FlashTimeout:
       type: int32_t
@@ -1451,5 +1452,6 @@ controls:
       type: int32_t
       direction: inout
       description: |
-        Torch intensity in mA. Used when the flash is operated in torch mode.
+        Torch intensity in microamperes. Used when the flash is operated in
+        torch mode.
 ...
diff --git a/src/libcamera/pipeline/simple/simple.cpp b/src/libcamera/pipeline/simple/simple.cpp
index aae3daaa..bd300965 100644
--- a/src/libcamera/pipeline/simple/simple.cpp
+++ b/src/libcamera/pipeline/simple/simple.cpp
@@ -40,6 +40,7 @@
 #include "libcamera/internal/delayed_controls.h"
 #include "libcamera/internal/device_enumerator.h"
 #include "libcamera/internal/formats.h"
+#include "libcamera/internal/flash_control.h"
 #include "libcamera/internal/global_configuration.h"
 #include "libcamera/internal/media_device.h"
 #include "libcamera/internal/pipeline_handler.h"
@@ -663,6 +664,7 @@ int SimpleCameraData::init()
 	}
 
 	properties_ = sensor_->properties();
+	FlashControl::updateFlashControls(sensor_->flash(), controlInfo_);
 
 	/* Find the first subdev that can generate a frame start signal, if any. */
 	frameStartEmitter_ = nullptr;
@@ -1718,6 +1720,10 @@ void SimplePipelineHandler::stopDevice(Camera *camera)
 	V4L2VideoDevice *video = data->video_;
 	V4L2Subdevice *frameStartEmitter = data->frameStartEmitter_;
 
+	/* Never leave a torch or strobe active after the camera stops. */
+	if (data->sensor_->flash())
+		data->sensor_->flash()->setMode(CameraFlash::Mode::None);
+
 	if (frameStartEmitter) {
 		frameStartEmitter->setFrameStartEnabled(false);
 		frameStartEmitter->frameStart.disconnect(data->delayedCtrls_.get(),
@@ -1748,6 +1754,14 @@ int SimplePipelineHandler::queueRequestDevice(Camera *camera, Request *request)
 	SimpleCameraData *data = cameraData(camera);
 	int ret;
 
+	/*
+	 * The simple pipeline has no hardware request queue for ancillary devices.
+	 * Apply flash controls when the request enters the pipeline and report the
+	 * resulting state in that request's metadata.
+	 */
+	FlashControl::handleFlashControls(data->sensor_->flash(), request->controls(),
+					  request->_d()->metadata());
+
 	std::map<const Stream *, FrameBuffer *> buffers;
 	bool metadataRequired = false;
 
-- 
2.55.0

