 include/libcamera/internal/camera_sensor.h    |   2 +
 src/libcamera/camera_flash.cpp                | 249 ++++++++++++++++++
 src/libcamera/meson.build                     |   1 +
 src/libcamera/sensor/camera_sensor_legacy.cpp |  13 +
 src/libcamera/sensor/camera_sensor_raw.cpp    |  13 +
