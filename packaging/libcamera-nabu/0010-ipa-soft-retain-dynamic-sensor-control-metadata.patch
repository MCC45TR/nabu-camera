From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mcc45tr <mcc45tr@gmail.com>
Date: Sun, 6 Sep 2026 09:47:09 +0300
Subject: [PATCH] ipa: soft: retain dynamic sensor control metadata

---
 src/ipa/simple/soft_simple.cpp | 21 ++++++++++++++++++++-
 1 file changed, 20 insertions(+), 1 deletion(-)

diff --git a/src/ipa/simple/soft_simple.cpp b/src/ipa/simple/soft_simple.cpp
index bd0e8f8b7..4908c8518 100644
--- a/src/ipa/simple/soft_simple.cpp
+++ b/src/ipa/simple/soft_simple.cpp
@@ -79,6 +79,7 @@ private:
 	SwIspStats *stats_;
 	std::unique_ptr<CameraSensorHelper> camHelper_;
 	ControlInfoMap sensorInfoMap_;
+	ControlInfoMap dynamicSensorInfoMap_;
 
 	/* Local parameter storage */
 	struct IPAContext context_;
@@ -426,7 +427,25 @@ void IPASoftSimple::processStats(const uint32_t frame,
 	 * control IDs from the cached map, but validate against the mode-specific
 	 * limits calculated above instead of its stale configure-time range.
 	 */
-	ControlList ctrls(sensorInfoMap_.idmap());
+	ControlInfoMap::Map dynamicSensorMap(sensorInfoMap_.begin(),
+					       sensorInfoMap_.end());
+	const auto exposureInfo = sensorInfoMap_.find(V4L2_CID_EXPOSURE);
+	const int32_t exposureMax = std::max(
+		context_.configuration.agc.exposureMin,
+		static_cast<int32_t>(context_.configuration.agc.sensorHeight) +
+			frameContext.sensor.vblank -
+			context_.configuration.agc.exposureMargin);
+	if (exposureInfo != sensorInfoMap_.end()) {
+		const int32_t exposureDefault = std::clamp(
+			frameContext.sensor.exposure,
+			context_.configuration.agc.exposureMin, exposureMax);
+		dynamicSensorMap[exposureInfo->first] = ControlInfo(
+			context_.configuration.agc.exposureMin, exposureMax,
+			exposureDefault);
+	}
+	dynamicSensorInfoMap_ = ControlInfoMap(std::move(dynamicSensorMap),
+					       sensorInfoMap_.idmap());
+	ControlList ctrls(dynamicSensorInfoMap_);
 
 	auto &againNew = frameContext.sensor.gain;
 	ctrls.set(V4L2_CID_VBLANK, frameContext.sensor.vblank);
