--- a/src/apps/qcam/main_window.h
+++ b/src/apps/qcam/main_window.h
@@ -62,6 +62,7 @@ private Q_SLOTS:
 
 	void switchCamera();
 	void toggleCapture(bool start);
+	void toggleTorch(bool enable);
 
 	void saveImageAs();
 	void captureRaw();
@@ -83,6 +84,8 @@ private:
 	void removeCamera(std::shared_ptr<libcamera::Camera> camera);
 
 	int queueRequest(libcamera::Request *request);
+	void updateCameraActions();
+	QString cameraDisplayName(const std::shared_ptr<libcamera::Camera> &camera) const;
 	void requestComplete(libcamera::Request *request);
 	void processCapture();
 	void processHotplug(HotplugEvent *e);
@@ -93,6 +96,7 @@ private:
 	QAction *startStopAction_;
 	QPushButton *cameraSelectButton_;
 	QAction *saveRaw_;
+	QAction *torchAction_;
 	ViewFinder *viewfinder_;
 
 	QIcon iconPlay_;
@@ -117,6 +121,7 @@ private:
 	/* Capture state, buffers queue and statistics */
 	bool isCapturing_;
 	bool captureRaw_;
+	bool torchEnabled_;
 	libcamera::Stream *vfStream_;
 	libcamera::Stream *rawStream_;
 	std::map<const libcamera::Stream *, QQueue<libcamera::FrameBuffer *>> freeBuffers_;
