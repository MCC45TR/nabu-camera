From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mcc45tr <mcc45tr@gmail.com>
Date: Sun, 6 Sep 2026 09:52:35 +0300
Subject: [PATCH] qcam: write torch mode only on transitions

---
 src/apps/qcam/main_window.cpp | 12 ++++++++++--
 src/apps/qcam/main_window.h   |  1 +
 2 files changed, 11 insertions(+), 2 deletions(-)

diff --git a/src/apps/qcam/main_window.cpp b/src/apps/qcam/main_window.cpp
index 103920e0e..f004a4157 100644
--- a/src/apps/qcam/main_window.cpp
+++ b/src/apps/qcam/main_window.cpp
@@ -93,7 +93,8 @@ private:
 MainWindow::MainWindow(CameraManager *cm, const OptionsParser::Options &options)
 	: saveRaw_(nullptr), torchAction_(nullptr), autofocusAction_(nullptr),
 	  autofocusProcess_(new QProcess(this)), options_(options), cm_(cm),
-	  isCapturing_(false), captureRaw_(false), torchEnabled_(false)
+	  isCapturing_(false), captureRaw_(false), torchEnabled_(false),
+	  torchUpdatePending_(false)
 {
 	int ret;
 
@@ -317,6 +318,7 @@ void MainWindow::switchCamera()
 void MainWindow::toggleTorch(bool enable)
 {
 	torchEnabled_ = enable;
+	torchUpdatePending_ = true;
 }
 
 void MainWindow::runAutofocus()
@@ -656,6 +658,9 @@ void MainWindow::stopCapture()
 	if (!isCapturing_)
 		return;
 
+	/* Pipeline stop forces the hardware off; keep the UI in sync. */
+	torchAction_->setChecked(false);
+
 	viewfinder_->stop();
 	if (saveRaw_)
 		saveRaw_->setEnabled(false);
@@ -885,9 +890,12 @@ void MainWindow::renderComplete(FrameBuffer *buffer)
 
 int MainWindow::queueRequest(Request *request)
 {
-	if (camera_->controls().find(&controls::FlashMode) != camera_->controls().end())
+	if (torchUpdatePending_ &&
+	    camera_->controls().find(&controls::FlashMode) != camera_->controls().end()) {
 		request->controls().set(controls::FlashMode,
 			torchEnabled_ ? controls::FlashModeTorch : controls::FlashModeNone);
+		torchUpdatePending_ = false;
+	}
 
 	return camera_->queueRequest(request);
 }
diff --git a/src/apps/qcam/main_window.h b/src/apps/qcam/main_window.h
index cfba6db6f..db2eacbe9 100644
--- a/src/apps/qcam/main_window.h
+++ b/src/apps/qcam/main_window.h
@@ -127,6 +127,7 @@ private:
 	bool isCapturing_;
 	bool captureRaw_;
 	bool torchEnabled_;
+	bool torchUpdatePending_;
 	libcamera::Stream *vfStream_;
 	libcamera::Stream *rawStream_;
 	std::map<const libcamera::Stream *, QQueue<libcamera::FrameBuffer *>> freeBuffers_;
